# PotholeFix FastAPI Backend Environment

# Application settings
APP_NAME=PotholeFix Municipal Platform
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Database Configuration (SQLite for 36-hr hackathon)
DATABASE_URL=sqlite:///./potholefix.db

# Cryptographic JWT Secret Key (Use a secure 32+ byte string in production)
SECRET_KEY=potholefix-hackathon-secure-jwt-secret-key-32chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Upload directory
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=10485760

# Frontend CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
