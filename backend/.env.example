# PotholeFix FastAPI Backend Environment

# Application settings
APP_NAME=PotholeFix Municipal Platform
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Database Configuration
# ----------------------
# Supabase PostgreSQL (Transaction Pooler - Port 6543, Recommended):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Supabase PostgreSQL (Direct / Session Mode - Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
#
# Local SQLite Fallback:
DATABASE_URL=sqlite:///./potholefix.db
SEED_DEMO_DATA=False

# Cryptographic JWT Secret Key (Use a secure 32+ byte string in production)
SECRET_KEY=potholefix-hackathon-secure-jwt-secret-key-32chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Configuration
# ---------------------
STORAGE_BACKEND=supabase
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key-here
SUPABASE_POTHOLE_BUCKET=pothole-images
SUPABASE_REPAIR_BUCKET=repair-evidence

# Local Fallback Upload Directory (when STORAGE_BACKEND=local)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=10485760

# Frontend CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
